{
  "title": "Synthetic test dashboard",
  "views": [
    {
      "title": "Home",
      "path": "home",
      "background": "/local/backgrounds/home.png",
      "cards": [
        {
          "type": "vertical-stack",
          "cards": [
            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#kitchen",
              "name": "Kitchen",
              "cards": [
                { "type": "custom:bubble-card", "card_type": "button", "entity": "light.kitchen_main" },
                {
                  "type": "custom:bubble-card",
                  "card_type": "button",
                  "entity": "fan.kitchen",
                  "sub_button": [
                    { "entity": "sensor.kitchen_temperature", "show_state": true },
                    { "entity": "light.kitchen_main" }
                  ]
                }
              ]
            },
            {
              "type": "custom:bubble-card",
              "card_type": "horizontal-buttons-stack",
              "1_link": "#kitchen",
              "1_name": "Kitchen",
              "1_entity": "binary_sensor.kitchen_motion",
              "2_link": "#garage",
              "2_name": "Garage",
              "2_entity": "cover.garage_door"
            }
          ]
        },
        {
          "type": "custom:button-card",
          "entity": "lock.front_door",
          "variables": { "battery": "sensor.front_door_battery" },
          "tap_action": { "action": "perform-action", "perform_action": "light.turn_on", "target": { "entity_id": "light.hallway" } },
          "custom_fields": {
            "temp": "[[[\n  return states['sensor.outdoor_temperature'].state + ' °C';\n]]]",
            "dotted": "[[[\nreturn hass.states.sensor.dotted_power;\n]]]"
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "primary": "{{ states('sensor.living_humidity') }} %",
          "secondary": "{% if is_state('switch.coffee_machine', 'on') %}Brewing{% endif %}\nscene.movie_night"
        },
        {
          "type": "entities",
          "entities": [
            "climate.lounge",
            { "entity": "media_player.lounge_speaker", "name": "Speaker" },
            { "entity": "light.old_lamp", "name": "Renamed long ago" },
            { "type": "section", "label": "Misc" }
          ]
        }
      ]
    }
  ]
}
