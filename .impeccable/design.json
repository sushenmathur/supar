      "description": "Actions on a madder banner: solid white primary, outlined secondary, turmeric when armed for confirm.",
      "html": "<div class=\"ds-b alert ds-banner\"><b>Garage door open</b><button class=\"ds-btn solid\">Close</button><button class=\"ds-btn line\">Snooze</button><button class=\"ds-btn armed\">Tap again to close</button></div>",
      "css": ".ds-b{position:relative;isolation:isolate;background:var(--cloth,#f7f9fd);color:var(--ink,#1b2559);border:solid var(--key,rgba(27,37,89,.42));border-width:2px 1.5px 1.5px 2px;border-radius:6px 5px 7px 5px;font:500 15px/1.3 Hind,system-ui,sans-serif}.ds-b>*{position:relative;z-index:2}.ds-b::after{content:'';position:absolute;inset:-2px -1.5px -1.5px -2px;z-index:1;pointer-events:none;border-radius:inherit;background:var(--pass,transparent);mix-blend-mode:multiply;transform:translate(3px,3px);transition:background .2s ease,transform .3s cubic-bezier(.2,.9,.3,1)}.ds-b.on{--pass:#f0ae2e;color:#2a1c00}.ds-b.alert{--pass:#b4362b;color:#fff}.ds-banner{display:flex;align-items:center;gap:14px;padding:4px 6px 4px 14px;min-height:58px}.ds-banner b{font-size:18px;flex:1}.ds-btn{min-height:48px;padding:0 18px;border-radius:5px;font:700 15px Hind,system-ui,sans-serif;border:1.5px solid transparent;background:none;cursor:pointer}.ds-btn:focus-visible{outline:3px solid #f0ae2e;outline-offset:3px}.ds-btn.solid{background:#fff;color:#b4362b}.ds-btn.line{border-color:rgba(255,255,255,.75);color:#fff}.ds-btn.armed{background:#f0ae2e;color:#2a1c00}.ds-btn:active{transform:translate(1px,1px)}"
    },
    {
      "name": "Alarm Segments",
      "kind": "button",
      "refersTo": "segment",
      "description": "Key-line outlined modes; current mode is a solid indigo fill.",
      "html": "<div class=\"ds-segs\"><button class=\"ds-seg cur\">Disarmed</button><button class=\"ds-seg\">Arm away</button></div>",
      "css": ".ds-segs{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:320px}.ds-seg{min-height:48px;border-radius:5px;border:solid rgba(27,37,89,.42);border-width:2px 1.5px 1.5px 2px;background:#f7f9fd;color:#1b2559;font:700 15px Hind,system-ui,sans-serif;cursor:pointer}.ds-seg:hover{background:#e9eef7}.ds-seg:focus-visible{outline:3px solid #f0ae2e;outline-offset:3px}.ds-seg.cur{background:#1b2559;color:#f7f9fd;border-color:transparent}"
