      "css": ".ds-b{position:relative;isolation:isolate;background:var(--cloth,#f7f9fd);color:var(--ink,#1b2559);border:solid var(--key,rgba(27,37,89,.42));border-width:2px 1.5px 1.5px 2px;border-radius:6px 5px 7px 5px;font:500 15px/1.3 Hind,system-ui,sans-serif}.ds-b>*{position:relative;z-index:3}.ds-b::after{content:'';position:absolute;inset:-2px -1.5px -1.5px -2px;z-index:1;pointer-events:none;border-radius:inherit;background:var(--pass,transparent);mix-blend-mode:multiply;transform:translate(3px,3px);transition:background .2s ease,transform .3s cubic-bezier(.2,.9,.3,1)}.ds-b::before{content:'';position:absolute;inset:-2px -1.5px -1.5px -2px;z-index:2;pointer-events:none;border-radius:inherit;border:solid transparent;border-width:2px 1.5px 1.5px 2px}.ds-b.on{--pass:#f0ae2e;color:#2a1c00}.ds-b.alert{--pass:#b4362b;color:#fff}.ds-acts{display:grid;grid-template-columns:repeat(2,minmax(150px,1fr));gap:10px;width:360px}.ds-act{min-height:52px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0 12px}.ds-act:focus-visible{outline:3px solid #f0ae2e;outline-offset:3px}.ds-act:active{transform:translate(1px,1px)}"
