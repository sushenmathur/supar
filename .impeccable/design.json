  "narrative": {
    "northStar": "The Block-Printed Wall Cloth",
    "overview": "The home is a length of hand-blocked cotton pinned to the kitchen wall. Every block of content is a cloth panel outlined by an indigo key line, pressed by hand, so the line is heavier on the top and left edges and the corners are never quite equal. Nothing glows, floats or frosts. State is not a badge or a toggle switch: it is a second colour pass printed over the block, turmeric when something is on, madder when something needs attention, and that pass lands slightly out of register with the key line, the way a real second block does.\n\nThe surface is dense and fixed: a single 1280 by 800 landscape stage on a wall tablet, read from across the room and tapped up close. Calm is the resting state (cloth, indigo, nothing printed over it); colour only arrives with meaning, so a glance across the kitchen counts the turmeric and madder blocks and knows what is happening. Light and dark follow the device: by day, indigo ink on neel-blued cotton; by night, the cloth is indigo-dyed and the ink turns pale.",
    "keyCharacteristics": [
      "Indigo key line on every block, hand-weighted (2px top and left, 1.5px right and bottom) with unequal corners.",
      "State printed as a flat colour pass, offset 3px down and right, overprinting the key line.",
      "Carved icon wells: solid indigo squares with the line icon cut out of them.",
      "A printed buti border repeat used sparingly as a selvedge edge.",
      "One humanist family (Hind) at heavy weights, tabular figures for every number.",
      "Flat throughout: no shadows, no gradients, no glass."
    ],
    "rules": [
      {
        "name": "The Two Passes Rule",
        "body": "A block carries at most one colour pass: turmeric for on, madder for attention. Calm blocks carry none. Never invent a third fill colour for state; green speaks only as text.",
        "section": "colors"
      },
      {
        "name": "The Overprint Rule",
        "body": "In light mode the pass prints with `multiply` blending so the key line shows through it; in dark mode it prints `normal`. The overprint is the look, not a bug to clean up.",
        "section": "colors"
      },
      {
        "name": "The Real Things Exception",
        "body": "Literal object colours stay literal: the family's monogram colours (a deep indigo and the madder) and the bin-lid swatches (charcoal, yellow, green) are the actual colours of those things and are not system tokens.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every live number (clock, temperatures, percentages, kWh, money, counts, dates) is set with tabular figures so values do not jitter as they update.",
        "section": "typography"
      },
      {
        "name": "The Heavy Hand Rule",
        "body": "Nothing on the stage is lighter than 500. Names and figures are 700; supporting lines are 600. Thin type does not survive the across-the-kitchen glance.",
        "section": "typography"
      },
      {
        "name": "The One Stage Rule",
        "body": "Design at 1280 by 800 and let the stage scale; do not reflow into breakpoints. Rows that can overflow clamp or ellipsize their text instead of growing.",
        "section": "layout"
      },
      {
        "name": "The 48px Floor Rule",
        "body": "Every tappable thing (tile, tab, button, segment, field) is at least 48px tall; sheet actions are 52px.",
        "section": "layout"
      },
      {
        "name": "The Printed, Not Lifted Rule",
        "body": "If something needs to stand out, give it a colour pass or a carved well, never a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Uneven Corner Rule",
        "body": "Block and well corners are deliberately unequal. Do not \"fix\" them to a uniform radius.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do put every container on cloth with the hand-weighted key line (2px top and left, 1.5px right and bottom) and the unequal block corners.",
      "Do show state as a colour pass printed 3px out of register: turmeric for on, madder for attention, nothing for calm.",
      "Do carve icons out of solid indigo wells; keep icons in the one sprite at a 2.1 stroke.",
      "Do set every live number in tabular figures, names at 700, supporting lines at 600.",
      "Do use Madder Text, not Madder, wherever red must be read as text on cloth.",
      "Do keep every tappable target at least 48px tall and design on the fixed 1280 by 800 stage.",
      "Do define every colour for both light and dark; dark mode prints the pass `normal` instead of `multiply`."
    ],
    "donts": [
      "Don't use shadows, blur, glass or gradients on blocks; depth is printed, not lifted.",
      "Don't put white text on turmeric, or fill a block with dabu green.",
      "Don't add a third state colour or a second accent; the dyes carry meaning, not decoration.",
      "Don't spread the buti beyond selvedge edges (tab bar foot, clock head); it is an edge, not a background.",
      "Don't even out the block corners or the key-line weights.",
      "Don't introduce a second typeface or weights below 500."
    ]
  }
}
