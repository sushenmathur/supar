      "css": ".ds-b{position:relative;isolation:isolate;background:var(--cloth,#f7f9fd);color:var(--ink,#1b2559);border:solid var(--key,rgba(27,37,89,.42));border-width:2px 1.5px 1.5px 2px;border-radius:6px 5px 7px 5px;font:500 15px/1.3 Hind,system-ui,sans-serif}.ds-b>*{position:relative;z-index:3}.ds-b::after{content:'';position:absolute;inset:-2px -1.5px -1.5px -2px;z-index:1;pointer-events:none;border-radius:inherit;background:var(--pass,transparent);mix-blend-mode:multiply;transform:translate(3px,3px);transition:background .2s ease,transform .3s cubic-bezier(.2,.9,.3,1)}.ds-b::before{content:'';position:absolute;inset:-2px -1.5px -1.5px -2px;z-index:2;pointer-events:none;border-radius:inherit;border:solid transparent;border-width:2px 1.5px 1.5px 2px}.ds-b.on{--pass:#f0ae2e;color:#2a1c00}.ds-b.alert{--pass:#b4362b;color:#fff}.ds-well{width:40px;height:40px;border-radius:5px 4px 6px 4px;display:grid;place-items:center;flex:none;background:var(--well,#1b2559);color:var(--well-ink,#f7f9fd)}.ds-b.alert .ds-well{background:rgba(255,255,255,.92);color:#b4362b}.ds-ic{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}.ds-tile{display:flex;align-items:center;gap:10px;padding:6px 12px;min-height:48px;min-width:200px;cursor:pointer;text-align:left}.ds-tile:focus-visible{outline:3px solid #f0ae2e;outline-offset:3px}.ds-tile:active{transform:translate(1px,1px)}.ds-name{display:block;font-size:15.5px;font-weight:700;line-height:1.15}.ds-sub{display:block;font-size:13.5px;font-weight:600;color:#47527f}.ds-b.on .ds-sub{color:rgba(42,28,0,.78)}.ds-b.alert .ds-sub{color:#fff}"
